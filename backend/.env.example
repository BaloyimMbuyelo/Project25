DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ubuntu_bistro_db

PORT=5000

# Required for login. Use a long random value, e.g.
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Browser origins allowed to call the API (comma-separated)
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Login session and lockout (defaults shown; System Design Table 14)
# JWT_EXPIRES_IN=8h
# LOGIN_MAX_ATTEMPTS=5
# LOCK_MIN=15
# Login requests allowed per IP per window
# LOGIN_RATE_LIMIT=20
# LOGIN_RATE_WINDOW_MIN=15
# The login cookie is Secure (works on https and http://localhost).
# Set to false only when testing over plain http on another LAN address.
# COOKIE_SECURE=true
